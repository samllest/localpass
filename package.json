{
  "name": "localpass",
  "version": "1.4.5",
  "description": "LocalPass 本地加密密码管理器与浏览器登录助手",
  "main": "./out/main/index.js",
  "author": "samllest",
  "homepage": "https://github.com/samllest/localpass",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "node --test",
    "test:extension": "node scripts/verify-extension.cjs",
    "test:site-data": "node scripts/verify-site-data.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "node scripts/build-windows.cjs",
    "build:icons": "node scripts/generate-icons.cjs",
    "package:distribution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-distribution.ps1",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:startup": "npm run build && node scripts/verify-startup.cjs",
    "test:projects": "node scripts/verify-project-matching.cjs",
    "test:updates": "node scripts/verify-updates.cjs",
    "test:storage-lifecycle": "node scripts/verify-storage-lifecycle.cjs",
    "test:installer": "node scripts/verify-installer-relaunch.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0"
  }
}
