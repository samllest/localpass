{
  "manifest_version": 3,
  "name": "LocalPass Auto Capturer",
  "version": "1.3.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Automatically captures login form submissions and pushes them to LocalPass.",
  "permissions": ["nativeMessaging", "webRequest", "storage", "tabs", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
