{
  "manifest_version": 3,
  "name": "LocalPass Auto Capturer",
  "version": "1.0",
  "description": "Automatically captures login form submissions and pushes them to LocalPass.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
