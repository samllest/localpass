{
  "manifest_version": 3,
  "name": "LocalPass Auto Capturer",
  "version": "1.4.3",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Captures successful login and registration credentials and saves them to LocalPass.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "storage",
    "tabs",
    "favicon",
    "offscreen",
    "alarms",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LocalPass · 连接与保存状态",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["network-observer.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
